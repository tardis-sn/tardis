---
name: csvy_full
model_density_time_0: 1 day
model_isotope_time_0: 0 day
description: Example csvy config file for TARDIS.
tardis_model_config_version: v1.0
datatype:
  fields:
    -  name: radius
       unit: cm
       desc: radii of shell boundaries.
    -  name: velocity
       unit: km/s
       desc: velocities of shell boundaries.
    -  name: density
       unit: g/cm^3
       desc: density of shell.
    -  name: t_rad
       unit: K
       desc: radiative temperature.
    -  name: dilution_factor
       desc: dilution factor of shell.
    -  name: H
       desc: fractional H abundance.
    -  name: He
       desc: fractional He abundance.
    -  name: Ni56
       desc: fractional Ni56 abundance.

---
radius,velocity,density,t_rad,dilution_factor,H,He,Ni56
1.0e14, 9000, 5e-10, 7000, .9, 1.0, 1.0, 1.0
3.0e14, 10500, 2.0e-10, 7000, .8, 0.0, 0.99, 0.01
9.0e14, 12000, 9e-11, 7000, .1, 0.4, 0.58, 0.02
